---
/**
 * FILTROS DEL CATÁLOGO
 *
 * Reglas que se respetan sí o sí:
 *  · Todos los modelos ya están en el HTML. El filtro solo oculta y muestra
 *    nodos existentes. Google ve el catálogo completo siempre.
 *  · El estado va en la querystring, así que un filtro se puede compartir por
 *    WhatsApp y llega igual al otro lado.
 *  · La barra aparece solo si hay JavaScript para atenderla: un control que no
 *    hace nada es peor que no tener el control.
 */
import { KITS } from '../config/site';

interface Props {
  /** Si en todo el catálogo no hay ningún precio cargado, el filtro de precio
   *  no se dibuja: filtrar por algo que nadie tiene es ruido. */
  conPrecio: boolean;
  total: number;
}

const { conPrecio, total } = Astro.props;

const DORMITORIOS = [
  { valor: 'todos', texto: 'Todos' },
  { valor: '1-2', texto: '1 a 2' },
  { valor: '3-5', texto: '3 a 5' },
];

const METRAJES = [
  { valor: 'todos', texto: 'Todos' },
  { valor: 'hasta-50', texto: 'Hasta 50' },
  { valor: '50-80', texto: '50 a 80' },
  { valor: 'mas-80', texto: 'Más de 80' },
];

const PRECIOS = [
  { valor: 'todos', texto: 'Todos' },
  { valor: 'hasta-15', texto: 'Hasta $15M' },
  { valor: '15-25', texto: '$15M a $25M' },
  { valor: 'mas-25', texto: 'Más de $25M' },
];

const ORDENES = [
  { valor: 'destacados', texto: 'Destacados' },
  { valor: 'm2-asc', texto: 'Menor m²' },
  { valor: 'm2-desc', texto: 'Mayor m²' },
  { valor: 'precio-asc', texto: 'Menor precio' },
];
---

<form class="filtros" data-filtros hidden aria-label="Filtrar el catálogo">
  <fieldset class="grupo">
    <legend class="etiqueta">Dormitorios</legend>
    <div class="grupo__opciones">
      {
        DORMITORIOS.map((op, i) => (
          <label class="chip">
            <input type="radio" name="rango" value={op.valor} checked={i === 0} />
            <span>{op.texto}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="grupo">
    <legend class="etiqueta">Metros cuadrados</legend>
    <div class="grupo__opciones">
      {
        METRAJES.map((op, i) => (
          <label class="chip">
            <input type="radio" name="m2" value={op.valor} checked={i === 0} />
            <span>{op.texto}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="grupo">
    <legend class="etiqueta">Formato</legend>
    <div class="grupo__opciones">
      <label class="chip">
        <input type="radio" name="kit" value="todos" checked />
        <span>Todos</span>
      </label>
      {
        KITS.map((kit) => (
          <label class="chip">
            <input type="radio" name="kit" value={kit.id} />
            <span>{kit.nombre}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  {
    conPrecio && (
      <fieldset class="grupo">
        <legend class="etiqueta">Precio</legend>
        <div class="grupo__opciones">
          {PRECIOS.map((op, i) => (
            <label class="chip">
              <input type="radio" name="precio" value={op.valor} checked={i === 0} />
              <span>{op.texto}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <div class="filtros__pie">
    <label class="orden">
      <span class="etiqueta">Ordenar por</span>
      <select name="orden">
        {ORDENES.map((op) => <option value={op.valor}>{op.texto}</option>)}
      </select>
    </label>

    <p class="filtros__contador" aria-live="polite">
      <span class="mono" data-contador>{total}</span>
      <span data-contador-texto>modelos</span>
    </p>

    <button class="filtros__limpiar" type="reset" data-limpiar>Limpiar filtros</button>
  </div>
</form>

<style>
  .filtros {
    display: grid;
    gap: var(--e-5);
    padding-block: var(--e-5);
    border-block: var(--grosor-cota) solid var(--linea);
  }

  .grupo {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .grupo__opciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-block-start: var(--e-3);
  }

  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--e-4);
    border-radius: var(--radio-control);
    border: var(--grosor-cota) solid var(--linea);
    font-size: var(--t-chico);
    color: var(--texto-suave);
    cursor: pointer;
    transition:
      background-color var(--dur-corta) var(--ease-suave),
      color var(--dur-corta) var(--ease-suave),
      border-color var(--dur-corta) var(--ease-suave);
  }

  .chip input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--texto-tenue);
    color: var(--texto);
  }

  .chip:has(input:checked) {
    background: var(--carbon);
    border-color: var(--carbon);
    color: var(--lino);
  }

  .chip:has(input:focus-visible) {
    outline: 2px solid var(--foco);
    outline-offset: 3px;
  }

  .filtros__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--e-4) var(--e-6);
    padding-block-start: var(--e-4);
    border-top: var(--grosor-cota) solid var(--linea-tenue);
  }

  .orden {
    display: grid;
    gap: var(--e-2);
  }

  .orden select {
    min-height: 44px;
    padding-inline: var(--e-3);
    border: var(--grosor-cota) solid var(--linea);
    border-radius: var(--radio);
    background: var(--superficie);
    font-size: var(--t-chico);
  }

  .filtros__contador {
    margin-inline-end: auto;
    font-size: var(--t-chico);
    color: var(--texto-suave);
    padding-block-end: var(--e-2);
  }

  .filtros__limpiar {
    min-height: 44px;
    padding-inline: var(--e-3);
    font-size: var(--t-chico);
    color: var(--cota);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  @media (min-width: 760px) {
    .filtros {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--e-5) var(--e-7);
    }

    .filtros__pie {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1080px) {
    .filtros {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
