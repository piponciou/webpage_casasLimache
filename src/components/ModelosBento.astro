---
/**
 * BENTO DE MODELOS
 * ================
 * La grilla del home. Seis modelos destacados más una celda de cotización.
 *
 * POR QUÉ ES UN BENTO Y NO UNA GRILLA PAREJA
 * Ocho tarjetas idénticas en filas de tres se leen como un inventario: el ojo
 * las recorre en zigzag y ninguna casa se ve. Con celdas de distinto ancho hay
 * un recorrido —una foto grande primero, tres medianas después, dos anchas al
 * cerrar— y cada foto tiene el tamaño que su encuadre aguanta.
 *
 * CÓMO ESTÁ ARMADO
 * Seis columnas en escritorio, dos en tablet, una en móvil. Las celdas SOLO
 * varían de ancho: ninguna abarca dos filas. Es deliberado — un `grid-row:
 * span 2` obliga a fijar el alto de las filas, y con fotos que reemplaza el
 * cliente eso termina recortando casas por la mitad. El alto lo pone el
 * contenido y la fila se empareja sola.
 *
 * EL ORDEN NO ES DECORATIVO
 * `MODO` empareja cada posición con el formato de foto que le corresponde. Si
 * el cliente marca un modelo más como destacado, la celda extra cae en el
 * patrón de tres medianas y la composición sigue cerrando.
 */
import ModeloCard from './ModeloCard.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import { mensajeGenerico } from '../lib/whatsapp';
import type { Modelo } from '../lib/catalogo';

interface Props {
  modelos: Modelo[];
}

const { modelos } = Astro.props;

/**
 * Ancho de celda y proporción de foto para cada modelo, en orden.
 * Sumadas a la celda de cotizar, las filas de escritorio cierran exactas en
 * seis columnas: [4+2] · [2+2+2] · [3+3].
 */
const MODO = [
  { span: 4, formato: 'panoramica' as const },
  { span: 2, formato: 'normal' as const },
  { span: 2, formato: 'normal' as const },
  { span: 2, formato: 'normal' as const },
  { span: 3, formato: 'panoramica' as const },
  { span: 3, formato: 'panoramica' as const },
];

/** Celda mediana: a esto caen los destacados que excedan las posiciones fijas. */
const RESERVA = { span: 2, formato: 'normal' as const };

type Celda =
  | { tipo: 'modelo'; modelo: Modelo; span: number; formato: 'normal' | 'alta' | 'panoramica' }
  | { tipo: 'cta'; span: number };

/**
 * La disposición es una sola lista en el orden EXACTO en que se imprime, porque
 * la grilla coloca por orden de documento. La celda de cotizar va segunda a
 * propósito: al final dejaba un hueco de cuatro columnas en la última fila y
 * empujaba el llamado a la acción fuera de la primera pantalla. En la posición
 * 2 completa la fila del modelo grande y queda temprano en la tabulación.
 */
const disposicion: Celda[] = modelos.flatMap((modelo, i) => {
  const celda: Celda = { tipo: 'modelo', modelo, ...(MODO[i] ?? RESERVA) };
  return i === 0 ? [celda, { tipo: 'cta', span: 2 }] : [celda];
});

/** En tablet solo hay dos columnas: las celdas anchas se llevan la fila entera. */
const spanTablet = (span: number) => (span >= 3 ? 2 : 1);
---

<div class="bento">
  {
    disposicion.map((celda, i) => (
      <div
        class="bento__celda"
        style={`--span: ${celda.span}; --span-tablet: ${spanTablet(celda.span)}`}
      >
        {celda.tipo === 'modelo' ? (
          <ModeloCard modelo={celda.modelo} formato={celda.formato} prioridad={i === 0} />
        ) : (
          /* Única superficie de madera de la sección: entre tarjetas blancas,
             el bloque cálido es lo que el ojo encuentra primero. */
          <div class="cta">
            <p class="cta__titulo">¿Cuál se parece a la que tienes en mente?</p>
            <p class="cta__texto">
              Cuéntanos el metraje y la comuna, y te mandamos el valor con despacho incluido.
            </p>

            {/* Una sola acción. El enlace al catálogo que vivía acá se movió al
                encabezado de la sección, como botón: acá competía con el
                llamado a cotizar, que es la conversión de la página. */}
            <div class="cta__acciones">
              <BotonWhatsApp
                mensaje={mensajeGenerico()}
                origen="home-bento"
                texto="Cotizar por WhatsApp"
                ancho
              />
            </div>
          </div>
        )}
      </div>
    ))
  }
</div>

<style>
  /* Móvil: una sola columna. El `--span` se ignora hasta que hay ancho real
     que repartir. */
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-4);
  }

  .bento__celda {
    display: flex;
    min-width: 0;
  }

  .bento__celda > :global(*) {
    width: 100%;
  }

  /* La celda de cotizar es un bloque de contenido, no una tarjeta enlazada:
     hereda la superficie cálida y el mismo radio que sus vecinas. */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--e-3);
    width: 100%;
    padding: var(--e-6);
    border-radius: var(--radio-bento);
    background: var(--superficie-calida);
  }

  .cta__titulo {
    font-family: var(--fuente-display);
    font-size: var(--t-sub);
    font-weight: 700;
    line-height: var(--interlinea-titular);
    letter-spacing: var(--tracking-titular);
    text-wrap: balance;
  }

  .cta__texto {
    max-width: 34ch;
    font-size: var(--t-chico);
    color: var(--texto-suave);
  }

  /* La celda de cotizar comparte fila con el modelo grande, así que hereda su
     alto. El bloque de acciones se va al fondo con `auto` en vez de quedar
     colgando bajo el texto: el aire cae entre el argumento y el botón, que es
     donde se lee como espacio y no como olvido. */
  .cta__acciones {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--e-2);
    width: 100%;
    margin-block-start: auto;
    padding-block-start: var(--e-5);
  }

  /* Tablet: dos columnas. Las celdas anchas se llevan la fila entera. */
  @media (min-width: 620px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--e-5);
    }

    .bento__celda {
      grid-column: span var(--span-tablet);
    }
  }

  /* Escritorio: la composición completa en seis columnas. */
  @media (min-width: 980px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--e-5);
    }

    .bento__celda {
      grid-column: span var(--span);
    }
  }
</style>
