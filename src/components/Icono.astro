---
/**
 * Set de íconos propio. No hay librería.
 * Todos comparten el mismo trazo de 1.5px de la cota, para que pertenezcan al
 * mismo sistema gráfico. Si un ícono no aporta información, no se usa.
 */
interface Props {
  nombre:
    | 'whatsapp'
    | 'flecha'
    | 'pin'
    | 'reloj'
    | 'mas'
    | 'buscar'
    | 'superficie'
    | 'cama'
    | 'bano'
    | 'sofa'
    | 'cocina'
    | 'telefono'
    | 'instagram'
    | 'facebook'
    | 'tiktok';
  tamano?: number;
  class?: string;
}

const { nombre, tamano = 20, class: clase } = Astro.props;
---

<svg
  class={clase}
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nombre === 'whatsapp' && (
      <>
        <path d="M3.2 20.8l1.3-4.4A8.4 8.4 0 1 1 7.9 19.4L3.2 20.8Z" />
        <path d="M9 8.3c.3-.6.6-.6.9-.6h.6c.2 0 .5 0 .7.5l.7 1.7c.1.3 0 .5-.1.7l-.4.5c-.1.2-.3.3-.1.6a7 7 0 0 0 3 2.6c.3.1.5.1.7-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.3.1.4.3.4.5 0 .4-.2 1.1-.6 1.4-.4.4-1 .6-1.7.5a10 10 0 0 1-6.8-6.4c-.2-.9-.1-1.4-.1-1.9Z" />
      </>
    )
  }
  {nombre === 'flecha' && <path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5" />}
  {
    nombre === 'pin' && (
      <>
        <path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" />
        <circle cx="12" cy="10" r="2.5" />
      </>
    )
  }
  {
    nombre === 'reloj' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7v5.3l3.3 2" />
      </>
    )
  }
  {nombre === 'mas' && <path d="M12 5v14M5 12h14" />}
  {
    nombre === 'buscar' && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16 16 4.5 4.5" />
      </>
    )
  }

  {/* Especificaciones de la ficha del hero. Mismo trazo de 1.5px que la cota. */}
  {
    nombre === 'superficie' && (
      <>
        <path d="M4 4h16v16H4z" />
        <path d="M10 4v6H4" />
      </>
    )
  }
  {
    nombre === 'cama' && (
      <>
        <path d="M3 18v-6a2 2 0 0 1 2-2h10a4 4 0 0 1 4 4v4" />
        <path d="M3 12V6M3 18v2M19 18v2M2.5 18h19" />
        <path d="M7 10V9a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1" />
      </>
    )
  }
  {
    nombre === 'bano' && (
      <>
        <path d="M3.5 12h17v2.5a4 4 0 0 1-4 4h-9a4 4 0 0 1-4-4V12Z" />
        <path d="M7 12V6.5a2 2 0 0 1 4 0" />
        <path d="M6.5 18.5 5.5 21M17.5 18.5l1 2.5" />
      </>
    )
  }
  {
    nombre === 'sofa' && (
      <>
        <path d="M5 12V8.5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2V12" />
        <path d="M3 15a2 2 0 0 1 4 0v1h10v-1a2 2 0 0 1 4 0v3.5H3V15Z" />
        <path d="M7 12h10" />
      </>
    )
  }
  {
    nombre === 'cocina' && (
      <>
        <path d="M4.5 4h15v16h-15z" />
        <path d="M4.5 9.5h15" />
        <path d="M9 13.5h6" />
        <circle cx="8.5" cy="6.75" r="1" />
        <circle cx="12.5" cy="6.75" r="1" />
      </>
    )
  }

  {
    nombre === 'telefono' && (
      <path d="M6.5 3.5h3l1.2 3.4-1.9 1.4a11 11 0 0 0 5.4 5.4l1.4-1.9 3.4 1.2v3a1.6 1.6 0 0 1-1.7 1.6A15.4 15.4 0 0 1 4.9 5.2 1.6 1.6 0 0 1 6.5 3.5Z" />
    )
  }

  {/* Marcas. Van dibujadas con el mismo trazo de 1.5px que el resto del set:
      un logo a color dentro de esta cabecera rompería la paleta, y el
      contorno se reconoce igual a 20px. */}
  {
    nombre === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="3.8" />
        <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    nombre === 'facebook' && (
      <path d="M17.5 3h-2.6A4.4 4.4 0 0 0 10.5 7.4V10.5H7.8v3.6h2.7V21h3.6v-6.9h2.7l.7-3.6h-3.4V7.9a1 1 0 0 1 1-1h2.4Z" />
    )
  }
  {
    nombre === 'tiktok' && (
      <path d="M13.4 3v11.6a3.5 3.5 0 1 1-3-3.46M13.4 3a5.6 5.6 0 0 0 5.3 5.2" />
    )
  }
</svg>
