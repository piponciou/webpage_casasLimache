---
/**
 * Footer de cuatro columnas: marca, navegación, contacto y medios de pago.
 *
 * SOBRE LAS PLACAS CLARAS
 * Ni el logo ni el sello de Webpay son blancos: el logo viene sobre fondo
 * blanco (es un JPEG, no tiene transparencia) y los logos de las tarjetas son
 * oscuros. Puestos directamente sobre el carbón, el primero deja un rectángulo
 * y los segundos desaparecen. Por eso los dos van sobre una placa clara, que
 * además es lo que hace cualquier sitio de comercio con estos sellos.
 *
 * SIN HILERA DE MODELOS
 * Hubo una que enlazaba las ocho fichas desde todas las páginas y se quitó por
 * decisión del cliente. Consecuencia a tener presente: Aconcagua y Peñablanca
 * no salen en el bento del home, así que ahora su único enlace interno es el
 * catálogo. Siguen indexables —están en el sitemap y a un clic de /catalogo/—
 * pero reciben menos enlaces internos que antes.
 */
import Icono from './Icono.astro';
import { SITE, DIRECCION, TELEFONO, HORARIOS, REDES, EMAIL, LEGAL, NAV } from '../config/site';
---

<footer class="pie invertido">
  <div class="envoltorio">
    <div class="pie__grilla">
      {/* 1 — Marca */}
      <section class="pie__bloque pie__bloque--marca" aria-labelledby="pie-marca">
        <h2 class="visualmente-oculto" id="pie-marca">{SITE.nombre}</h2>

        <img
          class="pie__logo"
          src="/images/og/casaslimache_logo.jpg"
          alt={`Logotipo de ${SITE.nombre}`}
          width="250"
          height="140"
          loading="lazy"
          decoding="async"
        />

        <p class="pie__resumen">
          Fabricamos y vendemos casas prefabricadas con despacho a todo Chile. Tenemos una casa
          piloto que puedes recorrer antes de decidir.
        </p>

        <ul class="sin-lista pie__redes">
          {
            REDES.map((red) => (
              <li>
                <a href={red.url} target="_blank" rel="noopener">
                  <Icono nombre={red.icono} tamano={20} />
                  <span class="visualmente-oculto">{red.nombre} de {SITE.nombre}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {/* 2 — Navegación */}
      <nav class="pie__bloque" aria-labelledby="pie-nav">
        <h2 class="pie__titulo" id="pie-nav">Navegación</h2>
        <ul class="sin-lista pie__lista">
          <li><a href="/">Inicio</a></li>
          {
            NAV.map((item) => (
              <li>
                <a href={item.href}>{item.texto}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* 3 — Contacto */}
      <section class="pie__bloque" aria-labelledby="pie-contacto">
        <h2 class="pie__titulo" id="pie-contacto">Contacto</h2>

        <ul class="sin-lista pie__datos">
          <li>
            <Icono nombre="telefono" tamano={19} />
            <a class="pie__telefono mono" href={`tel:${TELEFONO.tel}`}>{TELEFONO.visible}</a>
          </li>

          {
            EMAIL && (
              <li>
                <Icono nombre="flecha" tamano={19} />
                <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
              </li>
            )
          }

          <li>
            <Icono nombre="reloj" tamano={19} />
            <span>
              {
                HORARIOS.map((h) => (
                  <span class="pie__horario">
                    {h.dias}: {h.desde}–{h.hasta}
                  </span>
                ))
              }
            </span>
          </li>

          <li>
            <Icono nombre="pin" tamano={19} />
            <address class="pie__direccion">
              {DIRECCION.calle}, {DIRECCION.sector}<br />
              {DIRECCION.comuna}, {DIRECCION.region}
            </address>
          </li>
        </ul>
      </section>

      {/* 4 — Medios de pago */}
      <section class="pie__bloque" aria-labelledby="pie-pago">
        <h2 class="pie__titulo" id="pie-pago">Medios de pago</h2>
        <div class="pie__pagos">
          <img
            src="/images/pay_methods/webpay.png"
            alt="Webpay Transbank: Visa, MasterCard, Magna, American Express, Diners Club y Redcompra"
            width="520"
            height="200"
            loading="lazy"
            decoding="async"
          />
        </div>
      </section>
    </div>

    <div class="pie__legal">
      <p>{LEGAL.aviso}</p>
      <p class="pie__copy mono">© {LEGAL.anio} {SITE.nombreLegal}</p>
    </div>
  </div>
</footer>

<style>
  /* La franja de madera arriba separa el footer del contenido sin una línea
     gris más. Es el equivalente a la banda roja de la referencia, en la paleta
     de esta marca. */
  .pie {
    background: var(--superficie-oscura);
    color: var(--texto-invertido);
    border-top: 4px solid var(--madera);
    padding-block: var(--e-8) var(--e-5);
    margin-block-start: var(--e-8);
  }

  /* En móvil las cuatro columnas se apilan, así que la separación entre ellas
     se paga cuatro veces: ahí va más corta y solo se abre cuando hay columnas
     de verdad. */
  .pie__grilla {
    display: grid;
    gap: var(--e-6);
    grid-template-columns: 1fr;
  }

  .pie__titulo {
    font-family: var(--fuente-display);
    font-size: var(--t-cuerpo-grande);
    font-weight: 700;
    letter-spacing: var(--tracking-titular);
    margin-block-end: var(--e-4);
    color: var(--texto-invertido);
  }

  /* ---- 1. Marca ---------------------------------------------------------- */

  /* El logo es un JPEG sobre blanco: sin placa deja un rectángulo recortado
     contra el carbón. */
  .pie__logo {
    width: 190px;
    height: auto;
    padding: var(--e-3) var(--e-4);
    background: var(--nieve);
    border-radius: var(--radio);
  }

  .pie__resumen {
    margin-block-start: var(--e-4);
    max-width: 38ch;
    font-size: var(--t-chico);
    color: var(--texto-invertido-suave);
  }

  .pie__redes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-block-start: var(--e-5);
  }

  .pie__redes a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radio);
    border: 1px solid color-mix(in srgb, var(--lino) 26%, transparent);
  }

  .pie__redes a:hover {
    background: color-mix(in srgb, var(--lino) 12%, transparent);
    border-color: var(--madera);
  }

  /* ---- Enlaces ----------------------------------------------------------- */

  .pie a {
    color: var(--texto-invertido-suave);
    text-decoration: none;
    transition: color var(--dur-corta) var(--ease-suave);
  }

  .pie a:hover {
    color: var(--madera);
  }

  /* ---- 2. Navegación ----------------------------------------------------- */

  .pie__lista {
    display: grid;
    gap: var(--e-3);
    font-size: var(--t-chico);
  }

  /* El punto de la referencia. Es decorativo: no entra en el nombre del
     enlace ni lo lee un lector de pantalla. */
  .pie__lista li {
    display: flex;
    align-items: center;
    gap: var(--e-3);
  }

  .pie__lista li::before {
    content: '';
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    border: 1px solid var(--madera);
  }

  /* ---- 3. Contacto ------------------------------------------------------- */

  .pie__datos {
    display: grid;
    gap: var(--e-4);
    font-size: var(--t-chico);
    color: var(--texto-invertido-suave);
  }

  .pie__datos li {
    display: grid;
    grid-template-columns: 19px 1fr;
    gap: var(--e-3);
    align-items: start;
  }

  .pie__datos svg {
    margin-block-start: 0.15em;
    color: var(--madera);
  }

  .pie a.pie__telefono {
    font-size: var(--t-cuerpo-grande);
    color: var(--texto-invertido);
  }

  .pie__horario {
    display: block;
  }

  .pie__direccion {
    font-style: normal;
  }

  /* ---- 4. Medios de pago -------------------------------------------------- */

  /* Los sellos de las tarjetas son oscuros: sobre el carbón no se leen. La
     placa blanca es además como se muestran en cualquier checkout. */
  .pie__pagos {
    display: inline-flex;
    padding: var(--e-3) var(--e-4);
    background: var(--nieve);
    border-radius: var(--radio);
  }

  .pie__pagos img {
    width: 100%;
    max-width: 200px;
    height: auto;
  }

  /* En pantalla táctil los enlaces crecen a 44px de alto, y con eso el hueco
     de la lista sobra: los 44px ya separan un enlace del siguiente. */
  @media (pointer: coarse) {
    .pie__lista a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .pie__lista {
      gap: 0;
    }
  }

  /* ---- Legal -------------------------------------------------------------- */

  .pie__legal {
    margin-block-start: var(--e-6);
    padding-block-start: var(--e-4);
    border-top: var(--grosor-cota) solid color-mix(in srgb, var(--lino) 18%, transparent);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--e-3);
    font-size: var(--t-micro);
    color: color-mix(in srgb, var(--lino) 62%, var(--carbon));
  }

  .pie__legal p {
    max-width: 74ch;
  }

  @media (min-width: 560px) {
    .pie__grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--e-7) var(--e-6);
    }
  }

  /* Cuatro columnas como la referencia. La de marca pesa más porque lleva el
     logo y el párrafo. */
  @media (min-width: 1000px) {
    .pie__grilla {
      grid-template-columns: 1.5fr 1fr 1.3fr 1fr;
    }
  }
</style>
