---
/**
 * Footer. Cumple tres funciones a la vez:
 *  1. NAP completo, escrito exactamente igual que en el header y en el JSON-LD.
 *  2. Enlaces a todos los modelos y a todas las comunas: es el mapa interno que
 *     usa Google para llegar a cada ficha desde cualquier página.
 *  3. Aviso legal.
 *
 * Ni los modelos ni las comunas están escritos a mano: se iteran.
 */
import { SITE, DIRECCION, TELEFONO, HORARIOS, REDES, EMAIL, LEGAL, NAV } from '../config/site';
import { obtenerModelos, rutaModelo } from '../lib/catalogo';
import { COMUNAS } from '../data/comunas';
import { formatearM2 } from '../lib/formato';
import { rangoM2 } from '../lib/catalogo';

const modelos = await obtenerModelos();
---

<footer class="pie invertido">
  <div class="envoltorio">
    <div class="pie__grilla">
      <section class="pie__bloque pie__bloque--nap" aria-labelledby="pie-negocio">
        <h2 class="pie__titulo" id="pie-negocio">{SITE.nombre}</h2>

        <address class="pie__nap">
          <p>
            {DIRECCION.calle}, {DIRECCION.sector}<br />
            {DIRECCION.comuna}, {DIRECCION.region}
          </p>
          <p class="pie__referencia">{DIRECCION.referencia}</p>
          <p>
            <a class="pie__telefono mono" href={`tel:${TELEFONO.tel}`}>{TELEFONO.visible}</a>
          </p>
          {EMAIL && (
            <p>
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </p>
          )}
        </address>

        <ul class="sin-lista pie__horarios">
          {
            HORARIOS.map((h) => (
              <li>
                <span class="pie__dias">{h.dias}</span>
                <span class="mono">
                  {h.desde}–{h.hasta}
                </span>
                {h.nota && <span class="pie__nota">({h.nota})</span>}
              </li>
            ))
          }
        </ul>

        <ul class="sin-lista pie__redes">
          {
            REDES.map((red) => (
              <li>
                <a href={red.url} target="_blank" rel="noopener">
                  {red.nombre} <span class="pie__usuario">{red.usuario}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <nav class="pie__bloque" aria-labelledby="pie-modelos">
        <h2 class="pie__titulo" id="pie-modelos">Modelos</h2>
        <ul class="sin-lista pie__lista">
          {
            modelos.map((modelo) => {
              const rango = rangoM2(modelo.data);
              return (
                <li>
                  <a href={rutaModelo(modelo.data.slug)}>
                    {modelo.data.nombre}
                    <span class="pie__m2 mono">
                      {rango.min === rango.max
                        ? formatearM2(rango.min)
                        : `${rango.min}–${formatearM2(rango.max)}`}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <p class="pie__ver-todo">
          <a href="/catalogo/">Ver catálogo completo</a>
        </p>
      </nav>

      <nav class="pie__bloque" aria-labelledby="pie-comunas">
        <h2 class="pie__titulo" id="pie-comunas">Dónde despachamos</h2>
        <ul class="sin-lista pie__lista pie__lista--comunas">
          {
            COMUNAS.map((comuna) => (
              <li>
                <a href={`/casas-prefabricadas-${comuna.slug}/`}>{comuna.nombre}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="pie__bloque" aria-labelledby="pie-sitio">
        <h2 class="pie__titulo" id="pie-sitio">El sitio</h2>
        <ul class="sin-lista pie__lista">
          <li><a href="/">Inicio</a></li>
          {
            NAV.map((item) => (
              <li>
                <a href={item.href}>{item.texto}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="pie__legal">
      <p>{LEGAL.aviso}</p>
      <p class="pie__copy mono">© {LEGAL.anio} {SITE.nombreLegal}</p>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--superficie-oscura);
    color: var(--texto-invertido);
    padding-block: var(--e-8) var(--e-6);
    margin-block-start: var(--e-8);
  }

  .pie__grilla {
    display: grid;
    gap: var(--e-7) var(--canal);
    grid-template-columns: 1fr;
  }

  .pie__titulo {
    font-size: var(--t-cuerpo);
    font-weight: 600;
    letter-spacing: 0.01em;
    margin-block-end: var(--e-4);
    color: var(--texto-invertido);
  }

  .pie__nap {
    font-style: normal;
    color: var(--texto-invertido-suave);
  }

  .pie__nap p + p {
    margin-block-start: var(--e-3);
  }

  .pie__referencia {
    font-size: var(--t-chico);
    max-width: 34ch;
  }

  .pie a {
    color: var(--texto-invertido-suave);
    text-decoration: none;
    transition: color var(--dur-corta) var(--ease-suave);
  }

  .pie a:hover {
    color: var(--acento);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  /* Especificidad justa para ganarle a `.pie a` sin recurrir a !important. */
  .pie a.pie__telefono {
    font-size: var(--t-cuerpo-grande);
    color: var(--texto-invertido);
  }

  .pie__horarios {
    margin-block-start: var(--e-5);
    display: grid;
    gap: var(--e-2);
    font-size: var(--t-chico);
    color: var(--texto-invertido-suave);
  }

  .pie__horarios li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }

  .pie__dias {
    min-width: 11ch;
  }

  .pie__nota {
    color: var(--lapiz-claro);
  }

  .pie__redes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-5);
    margin-block-start: var(--e-5);
    font-size: var(--t-chico);
  }

  .pie__usuario {
    color: var(--lapiz-claro);
  }

  .pie__lista {
    display: grid;
    gap: var(--e-3);
    font-size: var(--t-chico);
  }

  .pie__lista a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-3);
    min-height: 24px;
  }

  /* En pantallas táctiles los enlaces del footer pasan a 44px de alto. En
     escritorio se quedan compactos: el puntero no necesita ese espacio y una
     lista de 25 enlaces a 44px cada uno sería un footer interminable. */
  @media (pointer: coarse) {
    .pie__lista a {
      min-height: 44px;
      align-items: center;
    }

    .pie__redes a,
    .pie__ver-todo a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .pie__lista {
      gap: 0;
    }
  }

  .pie__lista--comunas {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pie__m2 {
    font-size: var(--t-micro);
    color: var(--lapiz-claro);
    white-space: nowrap;
  }

  .pie__ver-todo {
    margin-block-start: var(--e-4);
    font-size: var(--t-chico);
  }

  .pie__ver-todo a {
    color: var(--acento);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .pie__legal {
    margin-block-start: var(--e-8);
    padding-block-start: var(--e-5);
    border-top: var(--grosor-cota) solid color-mix(in srgb, var(--zinc-marga) 22%, transparent);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--e-4);
    font-size: var(--t-micro);
    color: color-mix(in srgb, var(--zinc-marga) 62%, var(--tinta-fieltro));
  }

  .pie__legal p {
    max-width: 74ch;
  }

  @media (min-width: 700px) {
    .pie__grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .pie__grilla {
      grid-template-columns: 1.4fr 1fr 1fr 0.8fr;
    }
  }
</style>
