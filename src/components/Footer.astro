---
/**
 * Footer compacto.
 *
 * SE ACHICÓ, PERO NO SE VACIÓ — Y LA DIFERENCIA IMPORTA
 * La versión anterior era una grilla de cuatro columnas con listas verticales:
 * ocupaba casi una pantalla completa. Esta ocupa un tercio.
 *
 * Lo que NO se tocó son los enlaces. El footer es el único lugar del sitio que
 * enlaza las doce landings de comuna desde todas las páginas (solo /nosotros/ y
 * el 404 las mencionan además), y es la única ruta a los ocho modelos que no
 * depende del catálogo. Vaciarlo dejaría veinte páginas colgando de un solo
 * enlace interno.
 *
 * La solución no fue borrar enlaces sino cambiar su forma: de listas verticales
 * de 25 filas a hileras en línea separadas por puntos. Mismos enlaces, mismo
 * valor de rastreo, una fracción de la altura.
 *
 * Ni los modelos ni las comunas están escritos a mano: se iteran.
 */
import { SITE, DIRECCION, TELEFONO, HORARIOS, REDES, EMAIL, LEGAL } from '../config/site';
import { obtenerModelos, rutaModelo } from '../lib/catalogo';
import { COMUNAS } from '../data/comunas';

const modelos = await obtenerModelos();

/** "11:00–18:00" por bloque, en una sola línea. */
const horario = HORARIOS.map((h) => `${h.dias} ${h.desde}–${h.hasta}`).join(' · ');
---

<footer class="pie invertido">
  <div class="envoltorio">
    {/* El NAP va primero y en <address>: es el dato que Google cruza con la
        ficha de Google Business, y tiene que ser idéntico al del JSON-LD. */}
    <div class="pie__cabeza">
      <div class="pie__negocio">
        <h2 class="pie__marca">{SITE.nombre}</h2>

        <address class="pie__nap">
          <p>
            {DIRECCION.calle}, {DIRECCION.sector}, {DIRECCION.comuna}, {DIRECCION.region}
          </p>
          <p>
            <a class="pie__telefono mono" href={`tel:${TELEFONO.tel}`}>{TELEFONO.visible}</a>
            {EMAIL && <> · <a href={`mailto:${EMAIL}`}>{EMAIL}</a></>}
          </p>
          <p class="pie__horario">{horario}</p>
        </address>
      </div>

      <ul class="sin-lista pie__redes">
        {
          REDES.map((red) => (
            <li>
              <a href={red.url} target="_blank" rel="noopener">
                {red.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Mapa interno. En línea, no en columnas: el valor de enlace es el mismo y
        la altura baja de 25 filas a dos párrafos. */}
    <nav class="pie__mapa" aria-label="Modelos y zonas de despacho">
      <div class="pie__fila">
        <h3 class="pie__rotulo" id="pie-modelos">Modelos</h3>
        <ul class="sin-lista pie__enlaces" aria-labelledby="pie-modelos">
          {
            modelos.map((modelo) => (
              <li>
                <a href={rutaModelo(modelo.data.slug)}>{modelo.data.nombre}</a>
              </li>
            ))
          }
          <li><a class="pie__destacado" href="/catalogo/">Ver catálogo</a></li>
        </ul>
      </div>

      <div class="pie__fila">
        <h3 class="pie__rotulo" id="pie-comunas">Despachamos a</h3>
        <ul class="sin-lista pie__enlaces" aria-labelledby="pie-comunas">
          {
            COMUNAS.map((comuna) => (
              <li>
                <a href={`/casas-prefabricadas-${comuna.slug}/`}>{comuna.nombre}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="pie__legal">
      <p>{LEGAL.aviso}</p>
      <p class="pie__copy mono">© {LEGAL.anio} {SITE.nombreLegal}</p>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--superficie-oscura);
    color: var(--texto-invertido);
    padding-block: var(--e-7) var(--e-5);
    margin-block-start: var(--e-8);
  }

  .pie__cabeza {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
    gap: var(--e-4) var(--e-6);
  }

  .pie__marca {
    font-family: var(--fuente-display);
    font-size: var(--t-sub);
    font-weight: 700;
    letter-spacing: var(--tracking-titular);
    text-transform: uppercase;
    color: var(--texto-invertido);
  }

  .pie__nap {
    margin-block-start: var(--e-3);
    font-style: normal;
    font-size: var(--t-chico);
    color: var(--texto-invertido-suave);
  }

  .pie__nap p + p {
    margin-block-start: var(--e-2);
  }

  .pie a {
    color: var(--texto-invertido-suave);
    text-decoration: none;
    transition: color var(--dur-corta) var(--ease-suave);
  }

  .pie a:hover {
    color: var(--madera);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  /* Especificidad justa para ganarle a `.pie a` sin recurrir a !important. */
  .pie a.pie__telefono {
    font-size: var(--t-cuerpo-grande);
    color: var(--texto-invertido);
  }

  .pie__horario {
    color: color-mix(in srgb, var(--lino) 62%, var(--carbon));
  }

  .pie__redes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-4);
    font-size: var(--t-chico);
  }

  /* ---- Mapa interno -------------------------------------------------------
     Las hileras van con `display: contents` en el <ul> para que el rótulo y los
     enlaces compartan una sola línea base cuando hay ancho. */
  .pie__mapa {
    margin-block-start: var(--e-6);
    padding-block-start: var(--e-5);
    border-top: var(--grosor-cota) solid color-mix(in srgb, var(--lino) 18%, transparent);
    display: grid;
    gap: var(--e-4);
  }

  .pie__fila {
    display: grid;
    gap: var(--e-2);
  }

  .pie__rotulo {
    font-family: var(--fuente-mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-etiqueta);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--lino) 62%, var(--carbon));
  }

  /* Los enlaces en línea, separados por un punto que dibuja el ::before del
     hermano. El punto es decorativo: no entra en el nombre accesible. */
  .pie__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-3);
    font-size: var(--t-chico);
  }

  .pie__enlaces li {
    display: flex;
    align-items: center;
    gap: var(--e-3);
  }

  .pie__enlaces li + li::before {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--lino) 40%, transparent);
  }

  .pie__destacado {
    color: var(--madera);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  /* En pantalla táctil los enlaces crecen a 44px de alto. Con puntero se quedan
     compactos: es un footer, no un menú. */
  @media (pointer: coarse) {
    .pie__enlaces a,
    .pie__redes a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  .pie__legal {
    margin-block-start: var(--e-6);
    padding-block-start: var(--e-4);
    border-top: var(--grosor-cota) solid color-mix(in srgb, var(--lino) 18%, transparent);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--e-3);
    font-size: var(--t-micro);
    color: color-mix(in srgb, var(--lino) 62%, var(--carbon));
  }

  .pie__legal p {
    max-width: 74ch;
  }

  @media (min-width: 760px) {
    .pie__fila {
      grid-template-columns: 14ch 1fr;
      gap: var(--e-4);
      align-items: baseline;
    }
  }
</style>
