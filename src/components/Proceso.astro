---
/**
 * Los cuatro pasos de la compra.
 * Acá la numeración sí corresponde: es una secuencia y el orden es información.
 * Es el único lugar del sitio donde se numera.
 */
const PASOS = [
  {
    titulo: 'Eliges el modelo',
    detalle:
      'Miras el catálogo, filtras por metraje o por dormitorios y entras a la ficha del que te sirve.',
  },
  {
    titulo: 'Cotizas por WhatsApp',
    detalle:
      'El botón abre el chat con el modelo, el metraje y el formato ya escritos. No hay formulario.',
  },
  {
    titulo: 'Visitas la casa piloto',
    detalle:
      'Vienes a Camino Troncal y recorres la casa por dentro antes de comprometer nada.',
  },
  {
    titulo: 'Fabricamos y entregamos',
    detalle: 'Coordinamos el despacho a tu terreno, con el radier ya listo, y montamos.',
  },
];
---

<ol class="sin-lista proceso">
  {
    PASOS.map((paso, i) => (
      <li class="paso revelar">
        <span class="paso__numero mono" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="paso__titulo">{paso.titulo}</h3>
        <p class="paso__detalle">{paso.detalle}</p>
      </li>
    ))
  }
</ol>

<style>
  .proceso {
    display: grid;
    gap: var(--e-6);
    counter-reset: paso;
  }

  .paso {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--e-2) var(--e-4);
    padding-block-start: var(--e-4);
    border-top: var(--grosor-cota) solid var(--linea);
  }

  .paso__numero {
    grid-row: 1 / span 2;
    font-size: var(--t-chico);
    font-weight: 500;
    color: var(--cota);
    padding-block-start: 0.2em;
  }

  .paso__titulo {
    font-size: var(--t-cuerpo-grande);
    font-weight: 600;
  }

  .paso__detalle {
    color: var(--texto-suave);
    font-size: var(--t-chico);
    max-width: 40ch;
  }

  /* Escalonado corto: el orden de lectura se refuerza, no se decora. */
  .paso:nth-child(2) {
    transition-delay: 60ms;
  }
  .paso:nth-child(3) {
    transition-delay: 120ms;
  }
  .paso:nth-child(4) {
    transition-delay: 180ms;
  }

  /* Cuatro columnas de 150px dejarían los pasos ilegibles: en tablet van dos
     por fila y recién en escritorio se abren a cuatro. */
  @media (min-width: 560px) {
    .proceso {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--e-5) var(--e-6);
    }

    .paso {
      grid-template-columns: 1fr;
      gap: var(--e-2);
    }

    .paso__numero {
      grid-row: 1;
    }
  }

  @media (min-width: 940px) {
    .proceso {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--e-5);
    }
  }
</style>
