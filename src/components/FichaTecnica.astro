---
/**
 * Especificaciones técnicas del modelo.
 *
 * Antes este componente traía además la tabla de metrajes y valores y el
 * bloque de "qué incluye y qué no". Los dos se quitaron de la ficha: el
 * detalle de qué entra en cada compra ahora lo responde el comparador de
 * formatos que vive en la plantilla del modelo (#formatos-incluidos).
 */
import type { DatosModelo } from '../lib/catalogo';

interface Props {
  datos: DatosModelo;
}

const { datos } = Astro.props;

const FILAS: { etiqueta: string; valor: string }[] = [
  { etiqueta: 'Estructura', valor: datos.especificaciones.estructura },
  { etiqueta: 'Revestimiento exterior', valor: datos.especificaciones.revestimientoExterior },
  { etiqueta: 'Revestimiento interior', valor: datos.especificaciones.revestimientoInterior },
  { etiqueta: 'Techumbre', valor: datos.especificaciones.techumbre },
  { etiqueta: 'Ventanas', valor: datos.especificaciones.ventanas },
  { etiqueta: 'Aislación', valor: datos.especificaciones.aislacion },
  { etiqueta: 'Altura interior', valor: datos.especificaciones.altura },
];
---

<div class="ficha">
  <section aria-labelledby="titulo-especificaciones">
    <h2 id="titulo-especificaciones">Especificaciones</h2>

    <dl class="especificaciones">
      {
        FILAS.map((fila) => (
          <div class="especificaciones__fila">
            <dt>{fila.etiqueta}</dt>
            <dd>{fila.valor}</dd>
          </div>
        ))
      }
    </dl>

    <p class="ficha__nota">
      Especificaciones referenciales del modelo. Las terminaciones definitivas se confirman en la
      cotización, porque dependen del formato de compra que elijas.
    </p>
  </section>

</div>

<style>
  .ficha {
    display: grid;
    gap: var(--e-8);
  }

  /* Sin esto, la tabla de variantes (que tiene min-width para no aplastarse)
     estira la grilla y saca la página entera de la pantalla en 320px. */
  .ficha > * {
    min-width: 0;
  }

  .ficha h2 {
    margin-block-end: var(--e-5);
  }

  .especificaciones {
    display: grid;
  }

  .especificaciones__fila {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-1);
    padding-block: var(--e-3);
    border-top: var(--grosor-cota) solid var(--linea);
  }

  .especificaciones__fila:last-child {
    border-bottom: var(--grosor-cota) solid var(--linea);
  }

  .especificaciones dt {
    font-size: var(--t-micro);
    font-family: var(--fuente-mono);
    letter-spacing: var(--tracking-mono);
    color: var(--texto-tenue);
  }

  .especificaciones dd {
    margin: 0;
  }

  .ficha__nota {
    margin-block-start: var(--e-4);
    font-size: var(--t-micro);
    color: var(--texto-tenue);
    max-width: 58ch;
  }

  @media (min-width: 640px) {
    .especificaciones__fila {
      grid-template-columns: 20ch 1fr;
      gap: var(--e-4);
      align-items: baseline;
    }
  }
</style>
