---
/**
 * Especificaciones técnicas y tabla de variantes.
 *
 * La tabla de variantes no está oculta a propósito: es contenido útil y además
 * garantiza que cada combinación de metraje y formato exista en el HTML, con su
 * precio, para que Google la indexe sin ejecutar JavaScript.
 */
import { formatearPrecio } from '../lib/formato';
import { kitsDe, precioDeVariante } from '../lib/catalogo';
import type { DatosModelo } from '../lib/catalogo';

interface Props {
  datos: DatosModelo;
}

const { datos } = Astro.props;
const kits = kitsDe(datos);

const FILAS: { etiqueta: string; valor: string }[] = [
  { etiqueta: 'Estructura', valor: datos.especificaciones.estructura },
  { etiqueta: 'Revestimiento exterior', valor: datos.especificaciones.revestimientoExterior },
  { etiqueta: 'Revestimiento interior', valor: datos.especificaciones.revestimientoInterior },
  { etiqueta: 'Techumbre', valor: datos.especificaciones.techumbre },
  { etiqueta: 'Ventanas', valor: datos.especificaciones.ventanas },
  { etiqueta: 'Aislación', valor: datos.especificaciones.aislacion },
  { etiqueta: 'Altura interior', valor: datos.especificaciones.altura },
];
---

<div class="ficha">
  <section aria-labelledby="titulo-especificaciones">
    <h2 id="titulo-especificaciones">Especificaciones</h2>

    <dl class="especificaciones">
      {
        FILAS.map((fila) => (
          <div class="especificaciones__fila">
            <dt>{fila.etiqueta}</dt>
            <dd>{fila.valor}</dd>
          </div>
        ))
      }
    </dl>

    <p class="ficha__nota">
      Especificaciones referenciales del modelo. Las terminaciones definitivas se confirman en la
      cotización, porque dependen del formato de compra que elijas.
    </p>
  </section>

  <section aria-labelledby="titulo-variantes">
    <h2 id="titulo-variantes">Metrajes y valores</h2>

    <div class="tabla-envoltura">
      <table class="tabla">
        <caption class="visualmente-oculto">
          Metrajes disponibles del modelo {datos.nombre} y su valor por formato de compra
        </caption>
        <thead>
          <tr>
            <th scope="col">Superficie</th>
            <th scope="col">Dorm.</th>
            <th scope="col">Baños</th>
            {kits.map((kit) => <th scope="col">{kit.nombre}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            datos.variantes.map((variante) => (
              <tr>
                <th scope="row" class="mono">
                  {variante.m2} m²
                </th>
                <td class="mono">{variante.dormitorios}</td>
                <td class="mono">{variante.banos}</td>
                {kits.map((kit) => (
                  <td class="mono">{formatearPrecio(precioDeVariante(variante, kit.id))}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="titulo-incluye" id="formatos-modelo">
    <h2 id="titulo-incluye">Qué incluye y qué no</h2>

    <div class="incluye">
      <div>
        <h3 class="incluye__titulo">Incluye</h3>
        <ul class="sin-lista incluye__lista">
          {datos.incluye.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div>
        <h3 class="incluye__titulo">No incluye</h3>
        <ul class="sin-lista incluye__lista incluye__lista--no">
          {datos.noIncluye.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
</div>

<style>
  .ficha {
    display: grid;
    gap: var(--e-8);
  }

  /* Sin esto, la tabla de variantes (que tiene min-width para no aplastarse)
     estira la grilla y saca la página entera de la pantalla en 320px. */
  .ficha > * {
    min-width: 0;
  }

  .ficha h2 {
    margin-block-end: var(--e-5);
  }

  .especificaciones {
    display: grid;
  }

  .especificaciones__fila {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-1);
    padding-block: var(--e-3);
    border-top: var(--grosor-cota) solid var(--linea);
  }

  .especificaciones__fila:last-child {
    border-bottom: var(--grosor-cota) solid var(--linea);
  }

  .especificaciones dt {
    font-size: var(--t-micro);
    font-family: var(--fuente-mono);
    letter-spacing: var(--tracking-mono);
    color: var(--texto-tenue);
  }

  .especificaciones dd {
    margin: 0;
  }

  .ficha__nota {
    margin-block-start: var(--e-4);
    font-size: var(--t-micro);
    color: var(--texto-tenue);
    max-width: 58ch;
  }

  /* La tabla puede desbordar en móvil: se desplaza dentro de su caja, nunca
     empuja el ancho de la página. */
  .tabla-envoltura {
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .tabla {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-size: var(--t-chico);
  }

  .tabla th,
  .tabla td {
    padding: var(--e-3) var(--e-4);
    text-align: left;
    border-bottom: var(--grosor-cota) solid var(--linea);
  }

  .tabla thead th {
    font-family: var(--fuente-mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--texto-tenue);
    white-space: nowrap;
  }

  .tabla tbody th {
    font-weight: 500;
    white-space: nowrap;
  }

  .tabla tbody tr:hover {
    background: var(--tinta-10);
  }

  .incluye {
    display: grid;
    gap: var(--e-6);
  }

  .incluye__titulo {
    font-size: var(--t-cuerpo-grande);
    margin-block-end: var(--e-4);
  }

  .incluye__lista {
    display: grid;
    gap: var(--e-3);
    font-size: var(--t-chico);
    color: var(--texto-suave);
  }

  .incluye__lista li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: var(--e-3);
    align-items: start;
  }

  .incluye__lista li::before {
    content: '';
    margin-block-start: 0.7em;
    height: var(--grosor-cota);
    background: var(--cota);
    opacity: 0.55;
  }

  /* Lo que no incluye se marca con una cruz, no con un color de alerta: es
     información, no un error. */
  .incluye__lista--no li::before {
    background: var(--texto-tenue);
    opacity: 0.9;
    rotate: -45deg;
  }

  @media (min-width: 640px) {
    .especificaciones__fila {
      grid-template-columns: 20ch 1fr;
      gap: var(--e-4);
      align-items: baseline;
    }

    .incluye {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--e-7);
    }
  }
</style>
