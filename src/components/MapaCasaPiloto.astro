---
/**
 * Mapa de la casa piloto.
 *
 * EL MAPA SE VE DE ENTRADA
 * Antes había que tocar "Ver el mapa" para cargarlo. Eso protegía el LCP y
 * evitaba mandarle datos a Google sin que nadie lo pidiera, pero dejaba la
 * página sin lo que la gente viene a buscar: dónde queda.
 *
 * El iframe va con `loading="lazy"` y dentro de una caja con proporción fija,
 * así que no desplaza nada al llegar (cero CLS). Aun así tiene un costo: el
 * embed de Google pesa y, apenas se pinta, la visita queda registrada en sus
 * servidores. Es un intercambio consciente, no un descuido.
 *
 * La dirección sigue siendo texto en el HTML, no un pin dentro del iframe:
 * Google no lee lo que hay dentro de un embed, y ese texto es el que sostiene
 * el NAP junto al del footer y al del JSON-LD.
 *
 * Las coordenadas salen de site.ts y están verificadas contra la ficha de
 * Google Business del negocio.
 */
import Icono from './Icono.astro';
import { DIRECCION, SITE, STREET_VIEW } from '../config/site';

const punto = `${DIRECCION.geo.lat},${DIRECCION.geo.lng}`;

/**
 * Lo que se ve embebido es el Street View de la fachada, no el plano.
 *
 * El plano con un pin dice dónde queda; esta vista dice cómo se reconoce la
 * casa al llegar, que es la pregunta real de alguien que viene por primera vez
 * a un camino rural. Para "dónde queda" ya están la dirección en texto y el
 * botón de indicaciones, que además funcionan sin cargar nada de Google.
 *
 * El formato `pb` es el que usa el propio Google al compartir un panorama:
 *   !1s → panorama   !3f → rumbo   !4f → inclinación
 */
const urlEmbed = `https://www.google.com/maps/embed?pb=!3m1!1ses!5m1!1ses!6m5!1m4!1s${STREET_VIEW.panorama}!3f${STREET_VIEW.rumbo}!4f${STREET_VIEW.inclinacion}!5f1`;

const urlComoLlegar = `https://www.google.com/maps/dir/?api=1&destination=${punto}`;
---

<div class="mapa">
  <div class="mapa__marco">
    <iframe
      src={urlEmbed}
      title={`Vista de la fachada de la casa piloto de ${SITE.nombre} desde el camino, en ${DIRECCION.comuna}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>

  <div class="mapa__pie">
    <p class="mapa__direccion">
      {DIRECCION.calle}<br />
      <span class="mapa__sector">{DIRECCION.sector}, {DIRECCION.comuna}</span>
    </p>
    <p class="mapa__referencia">{DIRECCION.referencia}</p>

    <div class="mapa__acciones">
      <a class="boton boton--secundario" href={urlComoLlegar} target="_blank" rel="noopener">
        <Icono nombre="flecha" tamano={20} />
        Cómo llegar
      </a>

      {/* El enlace corto del cliente: abre este mismo panorama en Google Maps,
          donde se puede girar y recorrer el camino. */}
      <a class="boton boton--secundario" href={STREET_VIEW.enlace} target="_blank" rel="noopener">
        <Icono nombre="pin" tamano={20} />
        Abrir en Google Maps
      </a>
    </div>
  </div>
</div>

<style>
  /* El mapa se usa sobre fondo claro y podría volver a usarse sobre fondo
     tinta: los colores de texto son variables locales que se invierten solas
     dentro de una sección oscura. */
  .mapa {
    --mapa-texto: var(--texto);
    --mapa-suave: var(--texto-suave);
  }

  :global(.seccion--invertida) .mapa {
    --mapa-texto: var(--texto-invertido);
    --mapa-suave: var(--texto-invertido-suave);
  }

  /* La proporción la fija el marco, no el iframe: así el hueco existe desde el
     primer pintado y la carga del mapa no empuja el contenido de abajo. */
  .mapa__marco {
    aspect-ratio: 16 / 10;
    background: var(--carbon-10);
    border-radius: var(--radio-bento);
    overflow: hidden;
  }

  .mapa__marco iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .mapa__pie {
    margin-block-start: var(--e-4);
    color: var(--mapa-texto);
  }

  .mapa__direccion {
    font-family: var(--fuente-display);
    font-size: var(--t-sub);
    font-weight: 600;
    line-height: 1.2;
  }

  .mapa__sector {
    font-family: var(--fuente-texto);
    font-size: var(--t-cuerpo);
    font-weight: 400;
    color: var(--mapa-suave);
  }

  .mapa__referencia {
    margin-block-start: var(--e-2);
    font-size: var(--t-chico);
    color: var(--mapa-suave);
    max-width: 46ch;
  }

  .mapa__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-block-start: var(--e-4);
  }

  @media (min-width: 700px) {
    .mapa__marco {
      aspect-ratio: 16 / 9;
    }
  }
</style>
