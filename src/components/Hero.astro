---
/**
 * HERO
 * ====
 * Dos columnas: a la izquierda el aviso de casa piloto, el h1, la bajada y los
 * enlaces de rango; a la derecha la foto del modelo con su ficha sobreimpresa.
 *
 * SOBRE LA FICHA SOBREIMPRESA
 * Antes ese texto venía quemado dentro del JPEG, y como la caja del hero es más
 * cuadrada que la foto, `object-fit: cover` recortaba ~17% por lado y se comía
 * las letras. Ahora el texto es HTML: se arma con los datos del modelo elegido
 * en site.ts, se reacomoda solo en cada breakpoint y no se puede cortar.
 *
 * SOBRE LA LEGIBILIDAD
 * La foto la reemplaza el cliente y su color no lo controlamos. El scrim de
 * degradado está calculado para que el texto claro mantenga contraste AA
 * incluso sobre una foto blanca: por eso sostiene ~82% de opacidad a lo largo
 * de toda la banda de texto y recién ahí se suelta. Nada de text-shadow.
 *
 * El titular ES el <h1> y contiene "casas prefabricadas" + "Limache".
 */
import Icono from './Icono.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import { RANGOS, DIRECCION, HERO } from '../config/site';
import { mensajeGenerico } from '../lib/whatsapp';
import { obtenerModelos, varianteBase, rutaModelo } from '../lib/catalogo';
import { formatearM2, plural } from '../lib/formato';

const modelos = await obtenerModelos();

const destacado = modelos.find((m) => m.data.slug === HERO.modelo) ?? modelos[0]!;
const datos = destacado.data;
const base = varianteBase(datos);

/**
 * Especificaciones de la ficha sobre la foto: solo dormitorios y baños.
 * Living comedor y cocina se quitaron a propósito — están en la ficha del
 * modelo, y sobre la foto competían con el nombre y llenaban de ruido el
 * bloque. Los valores salen del JSON del modelo elegido en site.ts.
 */
const especificaciones = [
  { icono: 'cama' as const, texto: plural(base.dormitorios, 'dormitorio', 'dormitorios') },
  { icono: 'bano' as const, texto: plural(base.banos, 'baño', 'baños') },
];
---

<section class="hero" aria-labelledby="hero-titular">
  <div class="hero__interior">
    <div class="hero__texto">
      <a class="hero__aviso" href="/casa-piloto/">
        <span class="hero__aviso-punto" aria-hidden="true"></span>
        Casa piloto abierta en {DIRECCION.comuna}
        <Icono nombre="flecha" tamano={16} />
      </a>

      <h1 class="display hero__titular" id="hero-titular">Casas prefabricadas en Limache</h1>

      <p class="hero__bajada">Modelos de 36 a 120 m² con entrega inmediata.</p>

      {/* Reemplazan a las tarjetas de rango: mismos destinos, sin ocupar altura. */}
      <p class="hero__rangos">
        Ver casas
        {
          RANGOS.map((rango, i) => (
            <>
              {i > 0 && <span class="hero__separador" aria-hidden="true">·</span>}
              <a href={`/catalogo/?rango=${rango.id}`}>{rango.etiquetaCorta}</a>
            </>
          ))
        }
      </p>
    </div>

    <figure class="hero__media">
      {/* Un solo recorte 16:9 en todos los tamaños. La caja tiene esa misma
          proporción, así que `cover` no llega a recortar nada: la casa se ve
          entera tanto en escritorio como en celular. El navegador elige el
          ancho por srcset y el formato por type. */}
      <picture>
        <source
          type="image/webp"
          srcset="/images/hero/portada-800.webp 800w, /images/hero/portada-1200.webp 1200w, /images/hero/portada.webp 2000w"
          sizes="(min-width: 980px) 60vw, 100vw"
        />
        <img
          class="hero__foto"
          src="/images/hero/portada-1200.jpg"
          srcset="/images/hero/portada-800.jpg 800w, /images/hero/portada-1200.jpg 1200w, /images/hero/portada.jpg 2000w"
          sizes="(min-width: 980px) 60vw, 100vw"
          alt={`Modelo ${datos.nombre} de Casas Limache montado en un terreno de la Región de Valparaíso`}
          width="2000"
          height="1125"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="hero__scrim" aria-hidden="true"></div>

      <figcaption class="hero__ficha">
        <p class="hero__superficie">
          <Icono nombre="superficie" tamano={15} />
          <span class="mono">{formatearM2(base.m2)}</span>
        </p>

        <p class="hero__modelo">
          <a class="hero__enlace" href={rutaModelo(datos.slug)}>{datos.nombre}</a>
        </p>

        <ul class="sin-lista hero__specs">
          {
            especificaciones.map((spec) => (
              <li>
                <Icono nombre={spec.icono} tamano={17} />
                <span>{spec.texto}</span>
              </li>
            ))
          }
        </ul>
      </figcaption>
    </figure>
  </div>

  <div class="franja">
    <div class="franja__interior envoltorio">
      <p class="franja__texto">Elige tu modelo con nosotros.</p>
      <BotonWhatsApp mensaje={mensajeGenerico()} origen="hero-franja" texto="Cotizar por WhatsApp" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block-start: var(--e-6);
  }

  .hero__interior {
    display: grid;
    gap: var(--e-6);
    width: 100%;
    max-width: calc(var(--ancho-max) + var(--margen-cota) + var(--borde-pagina) * 2);
    margin-inline: auto;
    padding-inline-start: calc(var(--borde-pagina) + var(--margen-cota));
    padding-inline-end: var(--borde-pagina);
  }

  /* Aviso de casa piloto: no es una etiqueta decorativa, es un enlace con
     información que el titular no da. */
  .hero__aviso {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding-inline: var(--e-3);
    margin-inline-start: calc(var(--e-3) * -1);
    border-radius: var(--radio);
    font-size: var(--t-chico);
    color: var(--texto-suave);
    text-decoration: none;
    transition: color var(--dur-corta) var(--ease-suave);
  }

  .hero__aviso:hover {
    color: var(--texto);
  }

  .hero__aviso-punto {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--acento);
  }

  .hero__titular {
    margin-block-start: var(--e-3);
    max-width: 12ch;
  }

  .hero__bajada {
    margin-block-start: var(--e-5);
    max-width: 42ch;
    font-size: var(--t-cuerpo-grande);
    color: var(--texto-suave);
  }

  /* Enlaces de rango en una línea. Conservan el filtro del catálogo sin gastar
     la altura que necesitaban las tarjetas. */
  .hero__rangos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-1) var(--e-3);
    margin-block-start: var(--e-4);
    font-size: var(--t-chico);
    color: var(--texto-tenue);
  }

  .hero__rangos a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--cota);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .hero__separador {
    color: var(--linea);
  }

  /* En móvil la foto ocupa el ancho completo de la pantalla: sangra por los dos
     lados, incluido el margen de cota de la izquierda. Así la casa se ve lo más
     grande posible y el bloque de texto sobre ella gana altura. */
  .hero__media {
    position: relative;
    margin-inline-start: calc((var(--borde-pagina) + var(--margen-cota)) * -1);
    margin-inline-end: calc(var(--borde-pagina) * -1);
    overflow: hidden;
  }

  /* <picture> es inline por defecto y no propaga el tamaño a la imagen. */
  .hero__media picture {
    display: block;
  }

  /* 16:9 en TODOS los tamaños, igual que el archivo. Al coincidir la proporción
     de la caja con la de la foto, `cover` llena el marco sin recortar: la casa
     se ve completa y no quedan franjas vacías como dejaría `contain`. */
  .hero__foto {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Scrim: sostiene el negro a lo largo de toda la banda de texto y recién
     después se suelta. Un degradado que llega a 65% solo en el borde inferior
     deja el nombre del modelo en 1,9:1 sobre una foto clara.
     La curva llega hasta el 52% de la altura porque en móvil, con la foto en
     16:9, el bloque de texto ocupa la mitad del alto disponible. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 12, 11, 0.92) 0%,
      rgba(10, 12, 11, 0.88) 40%,
      rgba(10, 12, 11, 0.74) 62%,
      rgba(10, 12, 11, 0.36) 78%,
      rgba(10, 12, 11, 0) 96%
    );
    pointer-events: none;
  }

  /* En móvil la foto 16:9 mide ~211px de alto en un celular de 375px, así que
     el bloque va apretado: padding corto y sin espacios muertos entre líneas. */
  .hero__ficha {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: var(--e-1);
    padding: var(--e-4);
    color: var(--neblina);
  }

  .hero__superficie {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    font-size: var(--t-chico);
    color: var(--neblina);
  }

  .hero__modelo {
    font-family: var(--fuente-display);
    font-size: clamp(1.75rem, 1.1rem + 2.8vw, 3rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .hero__enlace {
    color: inherit;
    text-decoration: none;
  }

  /* Toda la foto lleva a la ficha del modelo, con un solo elemento enfocable. */
  .hero__enlace::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .hero__enlace:focus-visible {
    outline: none;
  }

  .hero__enlace:focus-visible::after {
    outline: 2px solid var(--acento);
    outline-offset: -4px;
    border-radius: 2px;
  }

  /* Con solo dos especificaciones caben en una fila incluso a 320px. */
  .hero__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-4);
    margin-block-start: var(--e-2);
    font-size: var(--t-chico);
  }

  .hero__specs li {
    display: flex;
    align-items: center;
    gap: var(--e-2);
  }

  .hero__specs svg {
    flex: 0 0 auto;
    opacity: 0.85;
  }

  /* Franja de cierre del hero: fondo tinta, ancho completo. */
  .franja {
    margin-block-start: var(--e-7);
    background: var(--superficie-oscura);
    color: var(--texto-invertido);
  }

  .franja__interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding-block: var(--e-5);
  }

  .franja__texto {
    font-family: var(--fuente-display);
    font-size: var(--t-sub);
    font-weight: 500;
    letter-spacing: var(--tracking-titular);
  }

  /* -------------------------------------------------------------------------
     El único momento coreografiado del sitio: la entrada del hero.
     ------------------------------------------------------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__aviso {
      animation: subir 520ms var(--ease-salida) both;
    }

    .hero__titular {
      animation: subir 620ms var(--ease-salida) 70ms both;
    }

    .hero__bajada {
      animation: subir 560ms var(--ease-salida) 160ms both;
    }

    .hero__rangos {
      animation: subir 540ms var(--ease-salida) 240ms both;
    }

    .hero__media {
      animation: descubrir 760ms var(--ease-salida) 150ms both;
    }
  }

  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes descubrir {
    from {
      opacity: 0;
      clip-path: inset(0 0 0 14%);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  @media (min-width: 700px) {
    .hero__ficha {
      padding: var(--e-6);
    }

    .hero__specs {
      display: flex;
      flex-wrap: wrap;
      gap: var(--e-2) var(--e-5);
    }
  }

  @media (min-width: 980px) {
    .hero {
      padding-block-start: var(--e-8);
    }

    /* Tiene que caer exactamente donde empieza el contenido de .envoltorio en
       el resto del sitio: si no, el hero queda desalineado con todo lo demás
       en pantallas anchas. */
    .hero__interior {
      max-width: none;
      margin-inline: 0;
      padding-inline-start: max(
        calc(var(--borde-pagina) + var(--margen-cota)),
        calc(
          (100% - (var(--ancho-max) + var(--margen-cota) + var(--borde-pagina) * 2)) / 2 +
            var(--borde-pagina) + var(--margen-cota)
        )
      );
      padding-inline-end: 0;
      /* 40% para el texto y 60% para la foto: la imagen es la protagonista. */
      grid-template-columns: minmax(0, 40fr) minmax(0, 60fr);
      gap: var(--e-7);
      align-items: center;
    }

    .hero__texto {
      padding-block: var(--e-4);
    }

    /* En escritorio vuelve a su columna y llega al borde derecho de la ventana. */
    .hero__media {
      margin-inline-start: 0;
      margin-inline-end: 0;
    }

    .hero__titular {
      max-width: 11ch;
    }

    .hero__ficha {
      padding: var(--e-7);
    }
  }
</style>
