---
/**
 * HERO
 * Arquitectura de información pedida en el brief: aviso de casa piloto, titular
 * grande, dos tarjetas de rango que son enlaces reales al catálogo filtrado, y
 * una franja de CTA al pie.
 *
 * El titular ES el <h1> y contiene "casas prefabricadas" + "Limache": así hay un
 * solo h1 por página, visible y sobre el pliegue, en vez de repetir dos veces la
 * misma frase con distinto tamaño.
 *
 * La cota vertical sobre la foto mide la altura libre real de la casa piloto,
 * que sale de las especificaciones del modelo, no de un número escrito a mano.
 */
import Icono from './Icono.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import { RANGOS, DIRECCION } from '../config/site';
import { mensajeGenerico } from '../lib/whatsapp';
import { obtenerModelos } from '../lib/catalogo';

const modelos = await obtenerModelos();
const modeloPiloto = modelos.find((m) => m.data.slug === 'lo-hidalgo') ?? modelos[0]!;
const alturaLibre = modeloPiloto.data.especificaciones.altura.split(' ')[0]!; // "2,40"
---

<section class="hero" aria-labelledby="hero-titular">
  <div class="hero__interior">
    <div class="hero__texto">
      <a class="hero__aviso" href="/casa-piloto/">
        <span class="hero__aviso-punto" aria-hidden="true"></span>
        Casa piloto abierta en {DIRECCION.comuna}
        <Icono nombre="flecha" tamano={16} />
      </a>

      <h1 class="display hero__titular" id="hero-titular">Casas prefabricadas en Limache</h1>

      <p class="hero__bajada">
        Modelos de 36 a 120 m² con entrega inmediata, y una casa piloto que puedes recorrer entera
        antes de decidir.
      </p>
    </div>

    <figure class="hero__media">
      <div class="hero__cota" aria-hidden="true">
        <span class="hero__cota-tramo"></span>
        <span class="hero__cota-valor mono">{alturaLibre} m</span>
        <span class="hero__cota-tramo"></span>
      </div>
      {/* Es la imagen del LCP. La versión de 800px existe para que un celular no
          descargue los 2000px de la de escritorio; la genera el mismo script que
          optimiza las fotos, así que quien reemplaza la portada sigue tocando un
          solo archivo. */}
      <img
        class="hero__foto"
        src="/images/hero/portada.jpg"
        srcset="/images/hero/portada-800.jpg 800w, /images/hero/portada.jpg 2000w"
        sizes="(min-width: 980px) 52vw, 100vw"
        alt="Casa prefabricada de Casas Limache montada en un terreno de la Región de Valparaíso"
        width="2000"
        height="1125"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="visualmente-oculto">
        Altura libre interior de {alturaLibre} metros en los modelos del catálogo.
      </figcaption>
    </figure>

    <div class="hero__rangos">
      {
        RANGOS.map((rango) => (
          <a class="rango" href={`/catalogo/?rango=${rango.id}`}>
            <span class="rango__titulo">{rango.titulo}</span>
            <span class="rango__detalle mono">{rango.detalle}</span>
            <span class="rango__flecha">
              <Icono nombre="flecha" tamano={18} />
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="franja">
    <div class="franja__interior envoltorio">
      <p class="franja__texto">Elige tu modelo con nosotros.</p>
      <BotonWhatsApp mensaje={mensajeGenerico()} origen="hero-franja" texto="Cotizar por WhatsApp" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block-start: var(--e-6);
  }

  .hero__interior {
    display: grid;
    gap: var(--e-6);
    width: 100%;
    max-width: calc(var(--ancho-max) + var(--margen-cota) + var(--borde-pagina) * 2);
    margin-inline: auto;
    padding-inline-start: calc(var(--borde-pagina) + var(--margen-cota));
    padding-inline-end: var(--borde-pagina);
  }

  /* Aviso de casa piloto: no es una etiqueta decorativa, es un enlace con
     información que el titular no da. */
  .hero__aviso {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding-inline: var(--e-3);
    margin-inline-start: calc(var(--e-3) * -1);
    border-radius: var(--radio);
    font-size: var(--t-chico);
    color: var(--texto-suave);
    text-decoration: none;
    transition: color var(--dur-corta) var(--ease-suave);
  }

  .hero__aviso:hover {
    color: var(--texto);
  }

  .hero__aviso-punto {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--acento);
  }

  .hero__titular {
    margin-block-start: var(--e-3);
    max-width: 12ch;
  }

  .hero__bajada {
    margin-block-start: var(--e-5);
    max-width: 42ch;
    font-size: var(--t-cuerpo-grande);
    color: var(--texto-suave);
  }

  /* La foto sangra hasta el borde derecho de la ventana. Sin radio, sin marco:
     el corte es el gesto. */
  .hero__media {
    position: relative;
    margin-inline-end: calc(var(--borde-pagina) * -1);
  }

  .hero__foto {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Cota vertical: mide la altura de la foto y dice un dato real de la casa. */
  .hero__cota {
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--margen-cota) * -0.62);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e-2);
    color: var(--cota);
    z-index: 1;
  }

  .hero__cota-tramo {
    position: relative;
    flex: 1;
    width: var(--grosor-cota);
    background: currentColor;
    opacity: 0.55;
    transform-origin: top center;
  }

  .hero__cota-tramo:last-child {
    transform-origin: bottom center;
  }

  .hero__cota-tramo::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 11px;
    height: var(--grosor-cota);
    background: currentColor;
    transform: translateX(-50%) rotate(45deg);
  }

  .hero__cota-tramo:first-child::after {
    top: 0;
  }

  .hero__cota-tramo:last-child::after {
    bottom: 0;
  }

  .hero__cota-valor {
    font-size: var(--t-micro);
    font-weight: 500;
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .hero__rangos {
    display: grid;
    gap: var(--e-3);
    grid-template-columns: 1fr;
  }

  .rango {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--e-1) var(--e-4);
    min-height: 84px;
    padding: var(--e-4) var(--e-5);
    background: var(--superficie);
    border-radius: var(--radio);
    box-shadow: var(--sombra-baja);
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow var(--dur-media) var(--ease-salida),
      transform var(--dur-media) var(--ease-salida);
  }

  .rango:hover {
    box-shadow: var(--sombra-media);
    transform: translateY(-2px);
  }

  .rango__titulo {
    font-weight: 500;
    line-height: 1.25;
  }

  .rango__detalle {
    grid-column: 1;
    font-size: var(--t-micro);
    color: var(--texto-tenue);
  }

  .rango__flecha {
    grid-row: 1 / span 2;
    grid-column: 2;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    color: var(--cota);
    background: var(--tinta-10);
    transition: transform var(--dur-media) var(--ease-salida);
  }

  .rango:hover .rango__flecha {
    transform: translateX(3px);
  }

  /* Franja de cierre del hero: fondo tinta, ancho completo. */
  .franja {
    margin-block-start: var(--e-7);
    background: var(--superficie-oscura);
    color: var(--texto-invertido);
  }

  .franja__interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding-block: var(--e-5);
  }

  .franja__texto {
    font-family: var(--fuente-display);
    font-size: var(--t-sub);
    font-weight: 500;
    letter-spacing: var(--tracking-titular);
  }

  /* -------------------------------------------------------------------------
     El único momento coreografiado del sitio: la entrada del hero.
     El aviso y el titular suben, la foto se descubre desde su borde izquierdo
     (el mismo gesto del corte que la sangra a la derecha), y recién entonces la
     cota se dibuja y aparece el numeral. Nada más se anima al cargar.
     ------------------------------------------------------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__aviso {
      animation: subir 520ms var(--ease-salida) both;
    }

    .hero__titular {
      animation: subir 620ms var(--ease-salida) 70ms both;
    }

    .hero__bajada {
      animation: subir 560ms var(--ease-salida) 160ms both;
    }

    .hero__media {
      animation: descubrir 760ms var(--ease-salida) 150ms both;
    }

    .hero__cota-tramo {
      animation: trazar 520ms var(--ease-salida) 520ms both;
    }

    .hero__cota-valor {
      animation: subir 420ms var(--ease-suave) 800ms both;
    }

    .rango {
      animation: subir 560ms var(--ease-salida) 260ms both;
    }

    .rango:nth-child(2) {
      animation-delay: 350ms;
    }
  }

  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes descubrir {
    from {
      opacity: 0;
      clip-path: inset(0 0 0 14%);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes trazar {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rango:hover,
    .rango:hover .rango__flecha {
      transform: none;
    }
  }

  @media (min-width: 620px) {
    .hero__rangos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .hero {
      padding-block-start: var(--e-8);
    }

    /* En escritorio la foto llega al borde derecho de la ventana. En vez de
       sacarla con un margen negativo calculado con 100vw (que ignora el ancho
       de la barra de scroll y provoca desborde horizontal), el contenedor deja
       de estar centrado: su padding izquierdo se calcula en porcentaje —que sí
       descuenta la barra— y el derecho es cero. */
    .hero__interior {
      max-width: none;
      margin-inline: 0;
      /* Tiene que caer exactamente donde empieza el contenido de .envoltorio en
         el resto del sitio: si no, el hero queda desalineado con todo lo demás
         en pantallas anchas. */
      padding-inline-start: max(
        calc(var(--borde-pagina) + var(--margen-cota)),
        calc(
          (100% - (var(--ancho-max) + var(--margen-cota) + var(--borde-pagina) * 2)) / 2 +
            var(--borde-pagina) + var(--margen-cota)
        )
      );
      padding-inline-end: 0;
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: var(--e-8) var(--e-7);
      align-items: start;
    }

    .hero__texto {
      grid-column: 1;
      grid-row: 1;
    }

    /* La foto ocupa las dos filas y llega hasta el borde de la ventana. */
    .hero__media {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
      margin-inline-end: 0;
      height: 100%;
    }

    .hero__foto {
      height: 100%;
      aspect-ratio: auto;
      min-height: 460px;
    }

    .hero__rangos {
      grid-column: 1;
      grid-row: 2;
      align-self: end;
    }

    .hero__titular {
      max-width: 14ch;
    }
  }
</style>
