---
/**
 * Ficha de modelo. Una URL real e indexable por cada archivo JSON del catálogo.
 * Ningún modelo está escrito acá: las rutas salen de la colección.
 */
import ModeloLayout from '../../layouts/ModeloLayout.astro';
import Galeria from '../../components/Galeria.astro';
import CotizadorWhatsApp from '../../components/CotizadorWhatsApp.astro';
import FichaTecnica from '../../components/FichaTecnica.astro';
import ComparadorKits from '../../components/ComparadorKits.astro';
import Cota from '../../components/Cota.astro';

import { obtenerModelos, rangoM2 } from '../../lib/catalogo';
import { formatearM2 } from '../../lib/formato';

export async function getStaticPaths() {
  const modelos = await obtenerModelos();

  // Ya no se calculan modelos relacionados: la grilla "Otros modelos" se quitó
  // de la ficha y el enlace entre fichas lo hace el footer, que las lista todas.
  return modelos.map((modelo) => ({
    params: { slug: modelo.data.slug },
    props: { modelo },
  }));
}

const { modelo } = Astro.props;
const datos = modelo.data;
const rango = rangoM2(datos);
const textoRango =
  rango.min === rango.max ? formatearM2(rango.min) : `${rango.min} – ${formatearM2(rango.max)}`;
---

<ModeloLayout datos={datos}>
  <div class="envoltorio">
    <nav class="migas" aria-label="Ruta de navegación">
      <ol class="sin-lista">
        <li><a href="/">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/catalogo/">Catálogo</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{datos.nombre}</li>
      </ol>
    </nav>

    <div class="modelo-detalle">
      <div class="modelo-detalle__galeria">
        <Galeria imagenes={datos.imagenes} nombre={datos.nombre} />
      </div>

      <div class="modelo-detalle__ficha">
        <h1 class="modelo-detalle__titulo">{datos.nombre}</h1>
        <p class="modelo-detalle__resumen">{datos.resumen}</p>
        <Cota valor={textoRango} etiqueta="Metrajes disponibles" class="modelo-detalle__cota" />

        <CotizadorWhatsApp datos={datos} />
      </div>
    </div>

    <div class="modelo-detalle__cuerpo">
      {/* La sección "Sobre el modelo" (tres párrafos de prosa) se eliminó: los
          datos que buscaba esa lectura ahora están en Especificaciones, que
          absorbió metrajes, dormitorios, baños y ambientes. */}
      <FichaTecnica datos={datos} />

      {/*
        Comparador de formatos, migrado desde el home. Ocupa el lugar exacto que
        tenía "Qué incluye y qué no" y responde la misma pregunta, pero por
        formato de compra en vez de por modelo.
        El id es el destino de los dos enlaces de la UI de compra: el del
        cotizador sticky y el del cierre de la página.
        Va acá arriba a propósito: tiene que renderizar antes que el apartado de
        cotización del cierre, para que ese salto sea siempre hacia arriba.
      */}
      <section class="seccion-formatos" id="formatos-incluidos" aria-labelledby="titulo-kits">
        <div class="encabezado-seccion">
          <h2 id="titulo-kits">¿Qué incluye cada formato?</h2>
        </div>

        <ComparadorKits />
      </section>

      {
        datos.plano && (
          <section class="plano" aria-labelledby="titulo-plano">
            <h2 id="titulo-plano">Distribución</h2>
            <img
              class="plano__imagen"
              src={datos.plano.src}
              alt={datos.plano.alt}
              width="1400"
              height="1050"
              loading="lazy"
              decoding="async"
            />
          </section>
        )
      }
    </div>
  </div>

  {/* Se eliminaron el cierre "¿Te sirve este modelo?" y la grilla "Otros
      modelos". El cotizador de arriba ya es sticky y acompaña toda la lectura,
      así que el cierre repetía un botón que nunca se pierde de vista.
      El enlace entre fichas lo sigue haciendo el footer, que lista los ocho
      modelos en todas las páginas del sitio. */}
</ModeloLayout>

<style>
  .migas {
    padding-block: var(--e-5) var(--e-4);
    font-size: var(--t-micro);
    font-family: var(--fuente-mono);
    color: var(--texto-tenue);
  }

  .migas ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }

  .migas a {
    color: var(--texto-tenue);
    text-decoration: none;
  }

  .migas a:hover {
    color: var(--texto);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .modelo-detalle {
    display: grid;
    gap: var(--e-6);
  }

  .modelo-detalle > *,
  .modelo-detalle__cuerpo > * {
    min-width: 0;
  }

  .modelo-detalle__titulo {
    font-family: var(--fuente-display);
    font-size: var(--t-titular);
    font-weight: 700;
    letter-spacing: var(--tracking-titular);
  }

  .modelo-detalle__resumen {
    margin-block-start: var(--e-3);
    color: var(--texto-suave);
    max-width: 44ch;
  }

  .modelo-detalle__cota {
    margin-block: var(--e-5);
  }

  .modelo-detalle__cuerpo {
    display: grid;
    gap: var(--e-8);
    margin-block-start: var(--e-9);
    /* Espacio para que la barra sticky de móvil no tape el final del contenido. */
    padding-block-end: var(--e-8);
  }


  .plano__imagen {
    width: 100%;
    max-width: 900px;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--carbon-10);
    border-radius: var(--radio);
  }

  .plano h2 {
    margin-block-end: var(--e-5);
  }

  @media (min-width: 900px) {
    .modelo-detalle {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--e-7);
      align-items: start;
    }

    /* La ficha acompaña la galería mientras se lee: el precio y el botón nunca
       quedan fuera de pantalla en escritorio. */
    .modelo-detalle__ficha {
      position: sticky;
      top: 100px;
    }

    .modelo-detalle__cuerpo {
      max-width: 62rem;
    }
  }
</style>
