---
/**
 * Catálogo completo.
 *
 * SIN FILTROS, A PROPÓSITO
 * Antes había una barra con cuatro filtros —dormitorios, metraje, formato y
 * precio— más un selector de orden. Se quitó porque prometía una criba que no
 * existe: los ocho modelos están disponibles en los tres formatos, así que
 * filtrar por formato devolvía siempre los ocho, y sin precios cargados el
 * filtro de precio no podía descartar ninguno. Un control que nunca cambia el
 * resultado enseña a desconfiar del resto de la página.
 *
 * Con ocho modelos, la grilla completa se recorre de una mirada. Si el catálogo
 * crece lo bastante como para necesitar una criba de verdad, este es el lugar
 * donde volvería, y con los filtros que sí discriminan: metraje y dormitorios.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ModeloCard from '../components/ModeloCard.astro';
import { obtenerModelos } from '../lib/catalogo';
import { migaDePan } from '../lib/schema';

const modelos = await obtenerModelos();

const jsonLd = [migaDePan([{ nombre: 'Catálogo', ruta: '/catalogo/' }])];
---

<BaseLayout
  titulo="Modelos de Casas Prefabricadas | Casas Limache"
  descripcion="Catálogo completo de casas prefabricadas de 36 a 120 m², de 2 a 5 dormitorios, con despacho a todo Chile. Cotiza el modelo que te sirve por WhatsApp."
  ruta="/catalogo/"
  jsonLd={jsonLd}
>
  <div class="envoltorio">
    <header class="cabecera-pagina">
      <h1>Catálogo de modelos</h1>
      <p class="prosa">
        Los ocho modelos que fabricamos, de 36 a 120 m². Todos se venden en los tres formatos de
        compra y se despachan a todo Chile.
      </p>
    </header>

    {/* El h2 es invisible pero necesario: los nombres de los modelos son h3 y
        sin él la jerarquía saltaría de h1 a h3. */}
    <section aria-labelledby="titulo-grilla">
      <h2 class="visualmente-oculto" id="titulo-grilla">Todos los modelos</h2>

      <div class="grilla-catalogo">
        {modelos.map((modelo, i) => <ModeloCard modelo={modelo} prioridad={i < 2} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .cabecera-pagina {
    padding-block: var(--e-7) var(--e-6);
  }

  .cabecera-pagina h1 {
    font-size: var(--t-titular);
  }

  .cabecera-pagina .prosa {
    margin-block-start: var(--e-4);
  }

  .grilla-catalogo {
    display: grid;
    gap: var(--e-5);
    grid-template-columns: 1fr;
    margin-block-start: var(--e-6);
  }

  @media (min-width: 481px) {
    .grilla-catalogo {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 901px) {
    .grilla-catalogo {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
