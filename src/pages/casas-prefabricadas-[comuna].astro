---
/**
 * Landings locales: /casas-prefabricadas-limache/, /casas-prefabricadas-olmue/…
 *
 * El contenido de cada comuna vive en src/data/comunas.ts y es distinto en cada
 * una: distancia real desde la casa piloto, tipo de terreno, clima y
 * condiciones de despacho. Si alguna vez no se puede escribir contenido
 * genuinamente propio para una comuna, se borra del archivo y la página deja de
 * generarse: es mejor no tener la landing que tener contenido duplicado.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ModeloCard from '../components/ModeloCard.astro';
import FAQ from '../components/FAQ.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Icono from '../components/Icono.astro';

import { COMUNAS } from '../data/comunas';
import { obtenerModelos } from '../lib/catalogo';
import { mensajeComuna, mensajeCasaPiloto } from '../lib/whatsapp';
import { migaDePan, paginaFaq } from '../lib/schema';
import { DIRECCION, HORARIOS } from '../config/site';

export async function getStaticPaths() {
  const modelos = await obtenerModelos();

  return COMUNAS.map((comuna) => ({
    params: { comuna: comuna.slug },
    props: { comuna, modelos },
  }));
}

const { comuna, modelos } = Astro.props;
const ruta = `/casas-prefabricadas-${comuna.slug}/`;

const preguntas = comuna.faq.map((p) => ({ ...p, enHome: false }));

const jsonLd = [
  migaDePan([{ nombre: `Casas prefabricadas en ${comuna.nombre}`, ruta }]),
  paginaFaq(comuna.faq),
];
---

<BaseLayout
  titulo={`Casas Prefabricadas en ${comuna.nombre} | Casas Limache`}
  descripcion={`Casas prefabricadas en ${comuna.conArticulo}: modelos de 36 a 120 m² con despacho a la comuna. ${comuna.bajada} Cotiza por WhatsApp con una ejecutiva.`.slice(
    0,
    160
  )}
  ruta={ruta}
  jsonLd={jsonLd}
>
  <div class="envoltorio">
    <nav class="migas" aria-label="Ruta de navegación">
      <ol class="sin-lista">
        <li><a href="/">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">Casas prefabricadas en {comuna.nombre}</li>
      </ol>
    </nav>

    <header class="cabecera-comuna">
      <h1>Casas prefabricadas en {comuna.nombre}</h1>
      <p class="cabecera-comuna__bajada">{comuna.bajada}</p>

      <div class="prosa cabecera-comuna__texto">
        {comuna.parrafos.map((parrafo) => <p>{parrafo}</p>)}
      </div>

      <div class="cabecera-comuna__acciones">
        <BotonWhatsApp
          mensaje={mensajeComuna(comuna.nombre)}
          origen={`landing-${comuna.slug}`}
          texto={`Cotizar con despacho a ${comuna.nombre}`}
        />
        <a class="boton boton--secundario" href="/catalogo/">Ver todos los modelos</a>
      </div>
    </header>
  </div>

  <section class="seccion" aria-labelledby="titulo-modelos">
    <div class="envoltorio">
      <div class="encabezado-seccion">
        <h2 id="titulo-modelos">Modelos con despacho a {comuna.nombre}</h2>
        <p>{comuna.introCatalogo}</p>
      </div>

      <div class="grilla-comuna">
        {modelos.map((modelo, i) => <ModeloCard modelo={modelo} prioridad={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="seccion seccion--invertida" aria-labelledby="titulo-piloto-comuna">
    <div class="envoltorio piloto-comuna">
      <div>
        <h2 id="titulo-piloto-comuna">Antes de comprar, ven a verla</h2>
        <p class="piloto-comuna__texto">
          La casa piloto está en {DIRECCION.calle}, {DIRECCION.sector}, {DIRECCION.comuna}.
          {DIRECCION.referencia} Puedes recorrerla entera antes de decidir, sin compromiso.
        </p>
        <ul class="sin-lista piloto-comuna__horarios">
          {
            HORARIOS.map((h) => (
              <li>
                <span>{h.dias}</span>
                <span class="mono">
                  {h.desde}–{h.hasta}
                </span>
                {h.nota && <span class="piloto-comuna__nota">({h.nota})</span>}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="piloto-comuna__acciones">
        <BotonWhatsApp
          mensaje={mensajeCasaPiloto()}
          origen={`landing-${comuna.slug}-piloto`}
          texto="Coordinar una visita"
        />
        <a class="boton boton--secundario" href="/casa-piloto/">
          <Icono nombre="pin" tamano={20} />
          Cómo llegar
        </a>
      </div>
    </div>
  </section>

  <section class="seccion" aria-labelledby="titulo-faq-comuna">
    <div class="envoltorio">
      <div class="encabezado-seccion">
        <h2 id="titulo-faq-comuna">Preguntas sobre {comuna.nombre}</h2>
        <p>
          Las generales están en <a href="/preguntas-frecuentes/">preguntas frecuentes</a>.
        </p>
      </div>

      <FAQ preguntas={preguntas} />
    </div>
  </section>
</BaseLayout>

<style>
  .migas {
    padding-block: var(--e-5) var(--e-4);
    font-size: var(--t-micro);
    font-family: var(--fuente-mono);
    color: var(--texto-tenue);
  }

  .migas ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
  }

  .migas a {
    color: var(--texto-tenue);
    text-decoration: none;
  }

  .migas a:hover {
    color: var(--texto);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .cabecera-comuna {
    padding-block: var(--e-5) var(--e-7);
  }

  .cabecera-comuna h1 {
    font-family: var(--fuente-display);
    font-size: var(--t-titular);
    font-weight: 700;
    max-width: 18ch;
  }

  .cabecera-comuna__bajada {
    margin-block-start: var(--e-3);
    font-size: var(--t-cuerpo-grande);
    color: var(--texto-suave);
    max-width: 46ch;
  }

  .cabecera-comuna__texto {
    margin-block-start: var(--e-6);
  }

  .cabecera-comuna__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-block-start: var(--e-6);
  }

  .grilla-comuna {
    display: grid;
    gap: var(--e-5);
    grid-template-columns: 1fr;
  }

  .piloto-comuna {
    display: grid;
    gap: var(--e-6);
  }

  .piloto-comuna__texto {
    margin-block-start: var(--e-4);
    max-width: 54ch;
    color: var(--texto-invertido-suave);
  }

  .piloto-comuna__horarios {
    display: grid;
    gap: var(--e-2);
    margin-block-start: var(--e-5);
    font-size: var(--t-chico);
    color: var(--texto-invertido-suave);
  }

  .piloto-comuna__horarios li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
  }

  .piloto-comuna__horarios li span:first-child {
    min-width: 12ch;
  }

  .piloto-comuna__nota {
    color: var(--lapiz-claro);
  }

  .piloto-comuna__acciones {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: var(--e-3);
  }

  @media (min-width: 640px) {
    .grilla-comuna {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 940px) {
    .grilla-comuna {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .piloto-comuna {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--e-8);
      align-items: center;
    }
  }
</style>
