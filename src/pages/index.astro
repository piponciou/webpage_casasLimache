---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ModelosBento from '../components/ModelosBento.astro';
import ClientesSlider from '../components/ClientesSlider.astro';
import Icono from '../components/Icono.astro';

import { obtenerDestacados } from '../lib/catalogo';
import { sitioWeb, organizacion } from '../lib/schema';

const destacados = await obtenerDestacados();

/**
 * El FAQPage salió junto con la sección de preguntas frecuentes: los datos
 * estructurados tienen que describir contenido visible en ESTA página, y
 * declarar un FAQPage sin preguntas a la vista es motivo de acción manual en
 * Search Console. Las preguntas siguen marcadas en /preguntas-frecuentes/ y en
 * las landings de comuna, que sí las muestran.
 */
const jsonLd = [sitioWeb(), organizacion()];
---

<BaseLayout
  titulo="Casas Prefabricadas en Limache y V Región | Casas Limache"
  descripcion="Casas prefabricadas en Limache, Olmué y toda la Región de Valparaíso. Casa piloto visitable en Villa Alemana y entrega inmediata. Cotiza por WhatsApp."
  ruta="/"
  jsonLd={jsonLd}
>
  <Hero />

  {/* C — Catálogo destacado.
       El h2 dice "casas prefabricadas" y no "Modelos destacados": es el único
       encabezado de sección del home y la consulta por la que se busca este
       negocio. El rango de metrajes no se perdió al quitar la bajada — sigue en
       la entradilla del hero ("Modelos de 36 a 120 m²"). */}
  <section class="seccion" aria-labelledby="titulo-destacados">
    <div class="envoltorio">
      <div class="encabezado-seccion">
        <h2 id="titulo-destacados">Modelos de casas prefabricadas</h2>

        {/* Botón de navegación al catálogo. Va en secundario a propósito: el
            primario de esta sección es cotizar por WhatsApp, que es la
            conversión. Dos rellenos compitiendo anulan la jerarquía. */}
        <a class="boton boton--secundario" href="/catalogo/">
          Ver catálogo
          <Icono nombre="flecha" tamano={20} />
        </a>
      </div>

      <ModelosBento modelos={destacados} />
    </div>
  </section>

  {/* D — Clientes.
       Ocupa el lugar que tenía la casa piloto: la prueba social va pegada al
       catálogo, mientras el modelo que la persona acaba de mirar sigue fresco.
       Reemplaza al bloque de testimonios, que mostraba en producción el texto
       de ejemplo "⚠️ REEMPLAZAR". Cinco fotos reales dicen más que tres
       testimonios inventados, y estos existen. */}
  <ClientesSlider />
</BaseLayout>
